#include <iostream>
#include <fstream>
#include <vector>
#include <cstdint>
#include <cmath>

typedef unsigned short WORD;
typedef unsigned long  DWORD;
typedef long           LONG;
typedef unsigned char  BYTE;

#pragma pack(push, 1)

struct BMPFileHeader {
	WORD type;
	DWORD size;
	WORD reserved1;
	WORD reserved2;
	DWORD offset;
};

struct BMPInfoHeader {
	DWORD size;
	LONG width;
	LONG height;
	WORD planes;
	WORD bitCount;
	DWORD compression;
	DWORD imageSize;
	LONG xPixelsPerMeter;
	LONG yPixelsPerMeter;
	DWORD colorsUsed;
	DWORD importantColors;
};

#pragma pack(pop)

struct Pixel {
	BYTE b;
	BYTE g;
	BYTE r;
};

bool readBMP(
	const char* filename,
	int& width,
	int& height,
	std::vector<Pixel>& pixels,
	int32_t& xPixelsPerMeter,
	int32_t& yPixelsPerMeter
) {
	std::ifstream file(filename, std::ios::binary);

	if (!file) {
		std::cerr << "Cannot open input file\n";
		return false;
	}

	BMPFileHeader fileHeader;
	BMPInfoHeader infoHeader;

	file.read(reinterpret_cast<char*>(&fileHeader), sizeof(fileHeader));
	file.read(reinterpret_cast<char*>(&infoHeader), sizeof(infoHeader));

	if (fileHeader.type != 0x4D42) {
		std::cerr << "File is not BMP\n";
		return false;
	}

	if (infoHeader.bitCount != 24) {
		std::cerr << "Only 24-bit BMP is supported\n";
		return false;
	}

	if (infoHeader.compression != 0) {
		std::cerr << "Compressed BMP is not supported\n";
		return false;
	}

	if (infoHeader.size < 40) {
		std::cerr << "Unsupported BMP header\n";
		return false;
	}

	width = infoHeader.width;

	bool bottomUp = infoHeader.height > 0;

	if (infoHeader.height > 0) {
		height = infoHeader.height;
	}
	else {
		height = -infoHeader.height;
	}

	xPixelsPerMeter = infoHeader.xPixelsPerMeter;
	yPixelsPerMeter = infoHeader.yPixelsPerMeter;

	pixels.resize(width * height);

	int rowSize = width * 3;
	int rowStride = (rowSize + 3) & ~3;

	std::vector<uint8_t> row(rowStride);

	file.seekg(fileHeader.offset, std::ios::beg);

	for (int fileRow = 0; fileRow < height; ++fileRow) {
		file.read(reinterpret_cast<char*>(row.data()), rowStride);

		if (!file) {
			std::cerr << "Error while reading BMP pixels\n";
			return false;
		}

		int y;

		if (bottomUp) {
			y = height - 1 - fileRow;
		}
		else {
			y = fileRow;
		}

		for (int x = 0; x < width; ++x) {
			int pos = 3 * x;

			Pixel pixel;

			pixel.b = row[pos];
			pixel.g = row[pos + 1];
			pixel.r = row[pos + 2];

			pixels[y * width + x] = pixel;
		}
	}

	return true;
}

std::vector<uint8_t> makeGrayscale(const std::vector<Pixel>& pixels) {
	std::vector<uint8_t> gray(pixels.size());

	for (std::size_t i = 0; i < pixels.size(); ++i) {
		int r = pixels[i].r;
		int g = pixels[i].g;
		int b = pixels[i].b;

		gray[i] = static_cast<uint8_t>((299 * r + 587 * g + 114 * b) / 1000);
	}

	return gray;
}

std::vector<uint8_t> sobel(
	const std::vector<uint8_t>& gray,
	int width,
	int height,
	double threshold
) {
	std::vector<uint8_t> result(width * height, 0);

	for (int y = 1; y < height - 1; ++y) {
		for (int x = 1; x < width - 1; ++x) {
			int gx = 0;

			gx += -gray[(y - 1) * width + (x - 1)];
			gx += gray[(y - 1) * width + (x + 1)];

			gx += -2 * gray[y * width + (x - 1)];
			gx += 2 * gray[y * width + (x + 1)];

			gx += -gray[(y + 1) * width + (x - 1)];
			gx += gray[(y + 1) * width + (x + 1)];

			int gy = 0;

			gy += gray[(y - 1) * width + (x - 1)];
			gy += 2 * gray[(y - 1) * width + x];
			gy += gray[(y - 1) * width + (x + 1)];

			gy += -gray[(y + 1) * width + (x - 1)];
			gy += -2 * gray[(y + 1) * width + x];
			gy += -gray[(y + 1) * width + (x + 1)];

			double gradient = std::sqrt(static_cast<double>(gx * gx + gy * gy));

			if (gradient > threshold) {
				result[y * width + x] = 255;
			}
			else {
				result[y * width + x] = 0;
			}
		}
	}

	return result;
}

bool writeBMP(
	const char* filename,
	int width,
	int height,
	const std::vector<uint8_t>& image,
	int32_t xPixelsPerMeter,
	int32_t yPixelsPerMeter
) {
	std::ofstream file(filename, std::ios::binary);

	if (!file) {
		std::cerr << "Cannot open output file\n";
		return false;
	}

	int rowSize = width * 3;
	int rowStride = (rowSize + 3) & ~3;

	uint32_t imageSize = static_cast<uint32_t>(rowStride * height);

	BMPFileHeader fileHeader{};

	fileHeader.type = 0x4D42;
	fileHeader.offset = sizeof(BMPFileHeader) + sizeof(BMPInfoHeader);
	fileHeader.size = fileHeader.offset + imageSize;

	BMPInfoHeader infoHeader{};

	infoHeader.size = sizeof(BMPInfoHeader);
	infoHeader.width = width;
	infoHeader.height = height;
	infoHeader.planes = 1;
	infoHeader.bitCount = 24;
	infoHeader.compression = 0;
	infoHeader.imageSize = imageSize;
	infoHeader.xPixelsPerMeter = xPixelsPerMeter;
	infoHeader.yPixelsPerMeter = yPixelsPerMeter;
	infoHeader.colorsUsed = 0;
	infoHeader.importantColors = 0;

	file.write(reinterpret_cast<const char*>(&fileHeader), sizeof(fileHeader));
	file.write(reinterpret_cast<const char*>(&infoHeader), sizeof(infoHeader));

	std::vector<uint8_t> row(rowStride, 0);

	for (int y = height - 1; y >= 0; --y) {
		for (int x = 0; x < width; ++x) {
			uint8_t value = image[y * width + x];
			int pos = 3 * x;

			row[pos] = value;
			row[pos + 1] = value;
			row[pos + 2] = value;
		}

		file.write(reinterpret_cast<const char*>(row.data()), rowStride);
	}

	return true;
}

int main() {
	std::string inputFile;
	std::string outputFile;

	std::cout << "Input file: ";
	std::cin >> inputFile;

	std::cout << "Output file: ";
	std::cin >> outputFile;

	double threshold;

	std::cout << "Threshold: ";
	std::cin >> threshold;

	int width;
	int height;
	int32_t xPixelsPerMeter;
	int32_t yPixelsPerMeter;

	std::vector<Pixel> pixels;

	if (!readBMP(inputFile.c_str(), width, height, pixels, xPixelsPerMeter, yPixelsPerMeter)) {
		return 1;
	}

	std::vector<uint8_t> gray = makeGrayscale(pixels);
	std::vector<uint8_t> edges = sobel(gray, width, height, threshold);

	if (!writeBMP(outputFile.c_str(), width, height, edges, xPixelsPerMeter, yPixelsPerMeter)) {
		return 1;
	}

	std::cout << "Done\n";

	return 0;
}
